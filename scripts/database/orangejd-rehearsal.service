[Unit]
Description=OrangeVC database migration rehearsal
After=mysql.service redis-server.service
Requires=mysql.service

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/data/orangejd
EnvironmentFile=/etc/orangejd/orangejd.env
EnvironmentFile=/etc/orangejd/mysql-selfhost.env
Environment=REDIS_DB=15
Environment=OSS_ENABLED=false
ExecStart=/usr/bin/java -Xms128m -Xmx768m -XX:MaxMetaspaceSize=256m -jar /data/orangejd/orange-server.jar --spring.profiles.active=prod --server.port=18080 --management.server.port=18081 --spring.datasource.url=jdbc:mysql://127.0.0.1:3306/orangevc_rehearsal?sslMode=REQUIRED&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8 --orange.beginner-projects.auto-refresh-enabled=false --orange.career-projects.auto-refresh-enabled=false
Restart=no
TimeoutStopSec=20
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/data/orangejd

