{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "oss:ListObjects"
      ],
      "Resource": [
        "acs:oss:*:*:orangevc-prod-media-1"
      ],
      "Condition": {
        "StringLike": {
          "oss:Prefix": [
            "database-backups/",
            "database-backups/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "oss:GetObject",
        "oss:GetObjectMeta",
        "oss:PutObject",
        "oss:DeleteObject"
      ],
      "Resource": [
        "acs:oss:*:*:orangevc-prod-media-1/database-backups/*"
      ]
    }
  ]
}
