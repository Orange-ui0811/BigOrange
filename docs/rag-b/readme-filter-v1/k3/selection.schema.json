{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "README_SELECTIONS_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "selections"],
  "properties": {
    "schemaVersion": {"const": "README_SELECTIONS_V1"},
    "selections": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["blockId", "decision", "kind", "scope", "reason"],
        "properties": {
          "blockId": {"type": "string", "minLength": 1},
          "decision": {"enum": ["KEEP", "DROP", "REVIEW"]},
          "kind": {"enum": ["PURPOSE", "TECHNICAL_TEXT", "USAGE", "ARCHITECTURE", "LICENSE", "LIMITATION", "MAINTENANCE", "SOURCE_POINTER", "OTHER"]},
          "scope": {"enum": ["CORE", "RELATED_PRODUCT", "ENTERPRISE", "COMMUNITY", "VERSION_SPECIFIC", "PLATFORM_SPECIFIC", "NON_PRODUCTION", "UNKNOWN"]},
          "reason": {"enum": ["KNOWLEDGE", "POINTER", "NOISE", "INSUFFICIENT", "CONFLICT", "UNCERTAIN"]}
        },
        "allOf": [
          {"if": {"properties": {"decision": {"const": "KEEP"}}},
           "then": {"properties": {"kind": {"not": {"const": "OTHER"}}, "scope": {"not": {"const": "UNKNOWN"}}},
             "if": {"properties": {"kind": {"const": "SOURCE_POINTER"}}},
             "then": {"properties": {"reason": {"const": "POINTER"}}},
             "else": {"properties": {"reason": {"const": "KNOWLEDGE"}}}}},
          {"if": {"properties": {"decision": {"const": "DROP"}}},
           "then": {"properties": {"reason": {"const": "NOISE"}}}}
        ]
      }
    }
  }
}
