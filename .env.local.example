MYSQL_DATABASE=orangejd
MYSQL_USER=orangejd
MYSQL_PASSWORD=orangejd_dev
MYSQL_ROOT_PASSWORD=root_dev

# Optional integrations. Core pages and APIs can run without these values.
MAIL_USERNAME=
MAIL_PASSWORD=
AI_AUDIT_KEY=
AI_TREND_KEY=
# Optional dedicated keys. When empty, they fall back to AI_TREND_*.
AI_PROJECT_ENDPOINT=
AI_PROJECT_KEY=
AI_PROJECT_MODEL=
AI_CONTRIBUTION_ENDPOINT=
AI_CONTRIBUTION_KEY=
AI_CONTRIBUTION_MODEL=
AI_EMBEDDING_KEY=
# Required only when saving dynamic AI keys from the admin console.
AI_CONFIG_ENCRYPTION_KEY=
INGESTION_PIPELINE_V2_ENABLED=false
# Isolated RAG B laboratory. Keep false until MySQL, Redis Stack and embedding are ready.
RAG_B_ENABLED=false
# Optional Gitee reranking; empty endpoint/key reuse AI_EMBEDDING_* for the same host.
RAG_B_RERANK_ENABLED=false
RAG_B_RERANK_MODEL=bge-reranker-v2-m3
RAG_B_RERANK_MAX_CANDIDATES=80
RAG_B_RERANK_BATCH_SIZE=20
RAG_B_RERANK_TIMEOUT_MILLIS=5000
RAG_B_GITHUB_SYNC_ENABLED=false
RAG_B_GITHUB_SYNC_LIMIT=50
RAG_B_GITHUB_SYNC_CRON=0 15 4 * * *
GITHUB_TOKEN=
TURNSTILE_SECRET_KEY=
# Optional local Turnstile test overrides. Defaults use Cloudflare's official always-pass test pair.
LOCAL_TURNSTILE_SITE_KEY=
LOCAL_TURNSTILE_SECRET_KEY=
# 客服总开关；启用后默认向所有登录账号开放。
CUSTOMER_ENABLED=false
CUSTOMER_MODEL=deepseek-flash
CUSTOMER_THINKING=false
CUSTOMER_ACTION_OUTPUT_TOKENS=4096
CUSTOMER_EVIDENCE_OUTPUT_TOKENS=2048
CUSTOMER_VERIFICATION_OUTPUT_TOKENS=2048
CUSTOMER_EVIDENCE_THINKING=false
CUSTOMER_VERIFICATION_THINKING=false
CUSTOMER_PURPOSE_THINKING=false
CUSTOMER_PURPOSE_OUTPUT_TOKENS=2048
CUSTOMER_PURPOSE_SECONDS=30
CUSTOMER_PURPOSE_RETRY_RESERVE_SECONDS=10
CUSTOMER_ALL_AUTHENTICATED_USERS=false
# 仅 CUSTOMER_ALL_AUTHENTICATED_USERS=false 时使用账号白名单。
CUSTOMER_ALLOWED_ACCOUNTS=
