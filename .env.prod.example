# Required: copy to a secret manager or a root-readable service EnvironmentFile.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=orangejd
MYSQL_USER=orangejd
MYSQL_PASSWORD=replace-with-a-random-database-password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace-with-a-random-redis-password

# Generate separately: openssl rand -base64 48
JWT_ADMIN_SECRET=replace-with-at-least-32-random-characters-admin
JWT_APP_SECRET=replace-with-at-least-32-random-characters-app
ALLOWED_ORIGINS=https://example.com,https://admin.example.com
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret
UPLOAD_PATH=/data/orangejd/uploads

# Optional integrations
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_ACCESS_SECRET=
OSS_BUCKET=
AI_AUDIT_ENDPOINT=
AI_AUDIT_KEY=
AI_TREND_ENDPOINT=
AI_TREND_KEY=
AI_EMBEDDING_ENDPOINT=https://ai.gitee.com/v1
AI_EMBEDDING_KEY=
GITHUB_TOKEN=
FEISHU_WEBHOOK_URL=

# Online payment remains disabled when all five values are empty.
EPAY_PID=
EPAY_KEY=
EPAY_GATEWAY=
EPAY_NOTIFY_URL=
EPAY_RETURN_URL=
