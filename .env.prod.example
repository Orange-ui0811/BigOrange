# Required: copy to a secret manager or a root-readable service EnvironmentFile.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=orangevc
MYSQL_USER=orangevc
MYSQL_PASSWORD=replace-with-a-random-database-password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace-with-a-random-redis-password

# Generate separately: openssl rand -base64 48
JWT_ADMIN_SECRET=replace-with-at-least-32-random-characters-admin
JWT_APP_SECRET=replace-with-at-least-32-random-characters-app
ALLOWED_ORIGINS=https://example.com,https://admin.example.com
PUBLIC_BASE_URL=https://example.com
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret
UPLOAD_PATH=/data/orangejd/uploads

# Optional integrations
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
OSS_ENABLED=true
OSS_ENDPOINT=https://oss-cn-shanghai-internal.aliyuncs.com
OSS_PUBLIC_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
OSS_REGION=cn-shanghai
OSS_ACCESS_KEY=
OSS_ACCESS_SECRET=
OSS_BUCKET=
OSS_SIGNED_URL_TTL_SECONDS=300
AI_AUDIT_ENDPOINT=
AI_AUDIT_KEY=
AI_AUDIT_MODEL=deepseek-v4-pro
AI_TREND_ENDPOINT=
AI_TREND_KEY=
AI_TREND_MODEL=DeepSeek-V4-Pro
AI_EMBEDDING_ENDPOINT=https://ai.gitee.com/v1
AI_EMBEDDING_KEY=
AI_EMBEDDING_MODEL=bge-small-zh-v1.5
GITHUB_TOKEN=
FEISHU_WEBHOOK_URL=
FEISHU_JOB_WEBHOOK_URL=
LEADERBOARD_LOCAL_CACHE_TTL=15

# Online payment remains disabled when all five values are empty.
EPAY_PID=
EPAY_KEY=
EPAY_GATEWAY=
EPAY_NOTIFY_URL=
EPAY_RETURN_URL=
