# Copy to /etc/orangejd/orangejd.env. Never put real values back into Git.
# Recommended ownership/permissions: root:root 0600.

MYSQL_HOST=YOUR_MYSQL_HOST
MYSQL_PORT=3306
MYSQL_DB=orangejd
MYSQL_USER=orangejd_app
MYSQL_PASSWORD=CHANGE_ME_WITH_A_RANDOM_DATABASE_PASSWORD

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_WITH_A_RANDOM_REDIS_PASSWORD

# Generate separately with: openssl rand -base64 48
JWT_ADMIN_SECRET=CHANGE_ME_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_APP_SECRET=CHANGE_ME_WITH_ANOTHER_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARS
ALLOWED_ORIGINS=https://orangevf.com
PUBLIC_BASE_URL=https://orangevf.com
TURNSTILE_SECRET_KEY=CHANGE_ME_ON_THE_SERVER
UPLOAD_PATH=/data/orangejd/uploads

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

OSS_ENABLED=false
OSS_ENDPOINT=
OSS_PUBLIC_ENDPOINT=
OSS_REGION=cn-shanghai
OSS_ACCESS_KEY=
OSS_ACCESS_SECRET=
OSS_BUCKET=
OSS_SIGNED_URL_TTL_SECONDS=300

AI_AUDIT_ENDPOINT=
AI_AUDIT_KEY=
AI_AUDIT_MODEL=
AI_TREND_ENDPOINT=
AI_TREND_KEY=
AI_TREND_MODEL=
# Optional dedicated configurations. When empty, they fall back to AI_TREND_*.
AI_PROJECT_ENDPOINT=
AI_PROJECT_KEY=
AI_PROJECT_MODEL=
AI_CONTRIBUTION_ENDPOINT=
AI_CONTRIBUTION_KEY=
AI_CONTRIBUTION_MODEL=
AI_EMBEDDING_ENDPOINT=
AI_EMBEDDING_KEY=
AI_EMBEDDING_MODEL=
# Generate separately with: openssl rand -base64 32
AI_CONFIG_ENCRYPTION_KEY=
# Keep false for the first deployment, then enable after the compatibility checks pass.
INGESTION_PIPELINE_V2_ENABLED=false
# Isolated RAG B laboratory; enabling it does not replace the existing RAG routes.
RAG_B_ENABLED=false
RAG_B_GITHUB_SYNC_ENABLED=false
RAG_B_GITHUB_SYNC_LIMIT=50
RAG_B_GITHUB_SYNC_CRON=0 15 4 * * *
GITHUB_TOKEN=
FEISHU_WEBHOOK_URL=
FEISHU_JOB_WEBHOOK_URL=
LEADERBOARD_LOCAL_CACHE_TTL=15

# Keep payment values empty and the feature false until all acceptance gates pass.
EPAY_PID=
EPAY_KEY=
EPAY_GATEWAY=
EPAY_NOTIFY_URL=
EPAY_RETURN_URL=
EPAY_ORDER_PAYMENTS_ENABLED=false

# Frontend build-time values; never put payment secrets in VITE_* variables.
VITE_TURNSTILE_SITE_KEY=
VITE_LEGAL_OPERATOR=YOUR_LEGAL_ENTITY_NAME
VITE_LEGAL_CONTACT_EMAIL=support@example.com
VITE_LEGAL_REGISTERED_ADDRESS=YOUR_REGISTERED_ADDRESS
VITE_LEGAL_CREDIT_CODE=YOUR_UNIFIED_SOCIAL_CREDIT_CODE
VITE_LEGAL_ICP_RECORD=YOUR_ICP_RECORD_NUMBER
VITE_LEGAL_PUBLIC_SECURITY_RECORD=YOUR_PUBLIC_SECURITY_RECORD_NUMBER
VITE_OFFICIAL_SITE_URL=https://orangevf.com
VITE_TRANSACTION_UI_ENABLED=false
VITE_REGISTRATION_ENABLED=true

# Deployment-only Nginx settings. Defaults follow the current Certbot layout.
NGINX_SITE_CONFIG=/etc/nginx/sites-enabled/orangejd
NGINX_SSL_CERTIFICATE=/etc/letsencrypt/live/orangevf.com/fullchain.pem
NGINX_SSL_CERTIFICATE_KEY=/etc/letsencrypt/live/orangevf.com/privkey.pem
# 客服总开关；启用后默认向所有登录账号开放。
CUSTOMER_ENABLED=false
CUSTOMER_MODEL=deepseek-flash
CUSTOMER_THINKING=false
CUSTOMER_ACTION_OUTPUT_TOKENS=4096
CUSTOMER_EVIDENCE_OUTPUT_TOKENS=2048
CUSTOMER_VERIFICATION_OUTPUT_TOKENS=2048
CUSTOMER_EVIDENCE_THINKING=false
CUSTOMER_VERIFICATION_THINKING=false
CUSTOMER_ALL_AUTHENTICATED_USERS=false
# 仅 CUSTOMER_ALL_AUTHENTICATED_USERS=false 时使用账号白名单。
CUSTOMER_ALLOWED_ACCOUNTS=
